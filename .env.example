# Copy to .env for local development. NEVER commit the real .env.
# In production these live in Vercel > Settings > Environment Variables.
#
# IMPORTANT: no VITE_ prefix. Vite inlines any VITE_* variable into the
# browser bundle, which would expose the token publicly.

# Meta Pixel id (public; also hard-coded in index.html for the browser Pixel)
META_PIXEL_ID=871472179206738

# Meta Conversions API access token (SECRET, server-side only).
# Events Manager > your dataset > Settings > Conversions API > Generate token
META_CAPI_TOKEN=

# Optional: while validating in Events Manager > Test Events. Remove when done.
META_TEST_EVENT_CODE=

# --- Jobber (quote form -> creates a client + work request) ---
# From the Jobber Developer Center app. Refresh token rotation must be OFF.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Filled once, after visiting /api/jobber/connect and authorizing (the callback
# page shows the token to copy here).
JOBBER_REFRESH_TOKEN=
# Optional: override the pinned GraphQL API version.
JOBBER_GRAPHQL_VERSION=2025-04-16
# Must match the OAuth callback URL registered on the Jobber app exactly
# (including www or not). Avoids www/non-www redirect_uri mismatches.
JOBBER_REDIRECT_URI=https://www.jtbuildersct.com/api/jobber/callback

# --- Blog (Supabase) ---
# Supabase dashboard > Connect > Framework: the project URL and the anon /
# publishable key. These two are the exception to the "no VITE_ prefix" rule
# above: the admin page runs in the browser and needs them, and that's safe
# because the anon key is public by design. Row Level Security decides what it
# can do (read published posts; writes only for users in public.admins).
# Also needed at build time on Vercel: scripts/fetch-posts.mjs reads with them.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local only, for `npm run db:push` and `npm run admin:create`. NEVER prefix
# with VITE_ and never add it to Vercel: it's full database access.
# Supabase > Connect > Direct > Session pooler > URI (the "Direct connection"
# is IPv6-only and fails on most home networks).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Vercel > Settings > Git > Deploy Hooks (branch: main). Server-side only:
# api/blog/publish.ts calls it after an admin verifies, to rebuild the blog.
VERCEL_DEPLOY_HOOK_URL=
